# Copy to secrets.py, fill in, and copy to the Presto alongside main.py.
WIFI_SSID = "your-network"
WIFI_PASSWORD = "your-password"

# Printed by `node feed.mjs` when it starts. Use your computer's LAN address, not 127.0.0.1.
FEED_URL = "http://192.168.0.200:8787/next.json"

# How often to refresh, in seconds.
REFRESH_SECONDS = 300

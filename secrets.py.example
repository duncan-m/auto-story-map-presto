# Copy to secrets.py, fill in, and copy to the Presto alongside story_map.py:
#   .venv/bin/mpremote cp secrets.py :secrets.py
# secrets.py is git-ignored. ./set-wifi.sh can update the Wi-Fi lines later.
WIFI_SSID = "your-network"
WIFI_PASSWORD = "your-password"

# Printed by `node feed.mjs` when it starts. Use your computer's LAN address, not 127.0.0.1.
# If your router hands your computer a new address, update this (or reserve one on the router).
FEED_URL = "http://192.168.1.10:8787/next.json"

# Lets the Presto start builds. Paste the contents of .build-token, which feed.mjs creates
# on first run. Leave it out and the Build with Claude button stays off.
BUILD_TOKEN = "paste-the-contents-of-.build-token"

# How often to refresh, in seconds. While a build is running it checks every minute.
REFRESH_SECONDS = 300
